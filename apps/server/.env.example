# Sao chép thành .env (file .env không được commit)
PORT=8787
# Postgres dev chạy bằng `pnpm db:up` (docker-compose.dev.yml)
DATABASE_URL=postgresql://stickmanwar:stickmanwar@127.0.0.1:5433/stickmanwar?schema=public
# Client ID OAuth loại "Web application" ở Google Cloud Console; bỏ trống = tắt đăng nhập Google
GOOGLE_CLIENT_ID=
# Trang admin (apps/admin): email Google được vào, cách nhau dấu phẩy. Email chỉ dùng để so, không lưu.
ADMIN_EMAILS=
# Mã bí mật vào admin không cần Google (dự phòng, ≥ 16 ký tự, ví dụ: openssl rand -hex 24); bỏ trống = tắt
ADMIN_TOKEN=
