{
  "name": "nguoi-que",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && vite build --ssr server/index.ts --outDir dist-server",
    "preview": "vite preview --host",
    "test": "vitest run",
    "server": "tsx watch server/index.ts",
    "start": "node dist-server/index.js"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
